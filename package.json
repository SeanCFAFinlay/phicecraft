{
  "name": "phicecraft",
  "version": "1.0.0",
  "description": "Hockey Drill Designer Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=flows --project=pwa --project=library --project=puck-actions --project=line-shapes --project=mobile-flows --project=a11y --project=perf --project=viewport-phone-320-portrait --project=viewport-phone-360-portrait --project=viewport-phone-390-portrait --project=viewport-phone-667-landscape --project=viewport-phone-844-landscape --project=viewport-tablet-768 --project=viewport-desktop-1366",
    "test:visual": "playwright test --project=visual-shell --project=visual-phone-portrait --project=visual-phone-landscape",
    "test:visual:update": "npm run test:visual -- --update-snapshots",
    "test:e2e:update": "playwright test --update-snapshots",
    "check:budgets": "node scripts/check-budgets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "lint": "eslint . --ext ts,tsx,mjs --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.14",
    "axe-core": "^4.12.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.24",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.0.0",
    "vite": "^4.3.9",
    "vitest": "^1.6.1"
  }
}
